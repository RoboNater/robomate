{
  "account": "testuser",
  "clone_repository": "$ORIGIN",
  "configs": {
    "bob": "$RUN_DIR/configs/bob.mcp.json",
    "charlie": "$RUN_DIR/configs/codex/config.toml"
  },
  "forge": "github",
  "harnesses": {
    "bob": "claude-code",
    "charlie": "codex"
  },
  "hub_repo": "$HUB_REPO",
  "issue": 42,
  "launch": {
    "agents": {
      "alice": {
        "effort": "",
        "harness": "claude-code",
        "max_resumes": null,
        "model": "",
        "resume_delay_s": 5.0,
        "resume_max_delay_s": 1800.0,
        "resume_prompt": "$RUN_DIR/resume-alice.prompt.md",
        "resume_script": "$RUN_DIR/resume-alice.sh",
        "resume_series_reset_s": 300.0,
        "resume_total_s": 43200.0,
        "script": "$RUN_DIR/start-alice.sh",
        "sessions": "$RUN_DIR/alice-sessions.jsonl"
      },
      "bob": {
        "effort": "",
        "harness": "claude-code",
        "max_resumes": null,
        "model": "",
        "resume_delay_s": 5.0,
        "resume_max_delay_s": 1800.0,
        "resume_prompt": "$RUN_DIR/resume-bob.prompt.md",
        "resume_script": "$RUN_DIR/resume-bob.sh",
        "resume_series_reset_s": 300.0,
        "resume_total_s": 43200.0,
        "script": "$RUN_DIR/start-bob.sh",
        "sessions": "$RUN_DIR/bob-sessions.jsonl"
      },
      "charlie": {
        "effort": "",
        "harness": "codex",
        "model": "",
        "resume_prompt": "$RUN_DIR/resume-charlie.prompt.md",
        "resume_script": "$RUN_DIR/resume-charlie.sh",
        "script": "$RUN_DIR/start-charlie.sh"
      }
    },
    "auto_start": true
  },
  "merge_method": "squash",
  "models": {
    "bob": "",
    "charlie": ""
  },
  "policy": {
    "allow_no_ci": true,
    "max_review_rounds": 3,
    "max_task_lease_min": 120,
    "max_wall_minutes": 180,
    "merge_method": "squash",
    "pairing_wait_s": 120,
    "role_policy": {
      "implementer_capabilities": [],
      "reviewer_capabilities": [],
      "reviewer_harness_differs": true,
      "reviewer_provider_differs": false
    },
    "stall_after_min": 20
  },
  "providers": {
    "bob": "anthropic",
    "charlie": "openai"
  },
  "repository": "$ORIGIN",
  "run_dir": "$RUN_DIR",
  "schema_version": 1,
  "slug": null,
  "state_dir": "$HUB_REPO/.robomate",
  "versions": {
    "claude": "2.1.277 (Claude Code)",
    "codex": "codex-cli 0.154.0"
  },
  "work": {
    "goal": "Address issue `$ORIGIN#42`, merge its pull request, and close out with no roadmap edit; record the merge only in the workflow summary.",
    "path": null,
    "roadmap": null,
    "sha256": null
  },
  "workspaces": {
    "bob": {
      "agent": "bob",
      "path": "$RUN_DIR/bob",
      "repository": "$ORIGIN",
      "workspace_id": "$BOB_ID"
    },
    "charlie": {
      "agent": "charlie",
      "path": "$RUN_DIR/charlie",
      "repository": "$ORIGIN",
      "workspace_id": "$CHARLIE_ID"
    }
  }
}
