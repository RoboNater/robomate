{
  "mcpServers": {
    "robomate": {
      "args": [
        "run",
        "--locked",
        "--project",
        "$ROOT",
        "robomate",
        "mcp",
        "--role",
        "worker"
      ],
      "command": "uv",
      "env": {
        "AGENT_NAME": "bob",
        "HUB_CAPABILITIES": "",
        "HUB_HARNESS": "claude-code",
        "HUB_HARNESS_VERSION": "2.1.277",
        "HUB_MODEL": "",
        "HUB_PROVIDER": "anthropic",
        "HUB_TELEMETRY_LOG": "$RUN_DIR/bob-telemetry.jsonl",
        "HUB_WORKSPACE": "$RUN_DIR/bob",
        "PYTHONUTF8": "1",
        "ROBOMATE_HUB_URL": "http://127.0.0.1:8420",
        "ROBOMATE_TOKEN_FILE": "$HUB_REPO/.robomate/token"
      }
    }
  }
}
