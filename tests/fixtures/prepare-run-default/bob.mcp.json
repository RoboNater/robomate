{
  "mcpServers": {
    "hub": {
      "args": [
        "run",
        "--locked",
        "--directory",
        "$ROOT",
        "worker-mcp"
      ],
      "command": "uv",
      "env": {
        "AGENT_NAME": "bob",
        "HUB_CAPABILITIES": "",
        "HUB_HARNESS": "claude-code",
        "HUB_HARNESS_VERSION": "2.1.277",
        "HUB_MODEL": "",
        "HUB_PROVIDER": "anthropic",
        "HUB_TELEMETRY_LOG": "$RUN_DIR/bob-telemetry.jsonl",
        "HUB_TOKEN": "$TOKEN",
        "HUB_URL": "http://127.0.0.1:8420",
        "HUB_WORKSPACE": "$RUN_DIR/bob",
        "PYTHONUTF8": "1"
      }
    }
  }
}
