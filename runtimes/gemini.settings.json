{
  "mcpServers": {
    "hub": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/agent-hub",
        "worker-mcp"
      ],
      "env": {
        "HUB_URL": "http://alice-host:8420",
        "HUB_TOKEN": "...",
        "AGENT_NAME": "charlie",
        "HUB_HARNESS": "gemini",
        "HUB_HARNESS_VERSION": "",
        "HUB_PROVIDER": "google",
        "HUB_MODEL": "",
        "HUB_CAPABILITIES": ""
      }
    }
  }
}
