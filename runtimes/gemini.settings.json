{
  "mcpServers": {
    "robomate": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/path/to/robomate",
        "robomate", "mcp", "--role", "worker"
      ],
      "env": {
        "ROBOMATE_HUB_URL": "http://alice-host:8420",
        "ROBOMATE_TOKEN_FILE": "/path/to/target/.robomate/token",
        "AGENT_NAME": "charlie",
        "HUB_HARNESS": "gemini",
        "HUB_HARNESS_VERSION": "",
        "HUB_PROVIDER": "google",
        "HUB_MODEL": "",
        "HUB_CAPABILITIES": ""
      }
    }
  }
}
